{
  "name": "petualang-kode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "node --env-file-if-exists=.env scripts/next.mjs build",
    "start": "node --env-file-if-exists=.env scripts/server.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env db/seed-dev.mjs"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "bcryptjs": "3.0.3",
    "blockly": "^13.5.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
