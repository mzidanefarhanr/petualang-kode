# PostgreSQL 15+
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scratch_kelas

# Object Storage (S3-kompatibel, bucket privat)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=scratch-kelas
S3_ACCESS_KEY_ID=ganti-dengan-access-key
S3_SECRET_ACCESS_KEY=ganti-dengan-secret-key

# Auth.js (NextAuth) - Strategi JWT lintas subdomain
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
AUTH_URL=http://app.localhost:3000

# Origin Aplikasi & Cookie Lintas Subdomain
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
NEXT_PUBLIC_EDITOR_URL=http://editor.localhost:8601
COOKIE_DOMAIN=.localhost

# Batas Operasional
MAX_SB3_SIZE_BYTES=52428800