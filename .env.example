# PostgreSQL 15+
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petualang_kode

# Penyimpanan Media (gambar & suara): local (dev/VPS) atau s3 (produksi)
MEDIA_STORAGE=local
MEDIA_DIR=.media
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=petualang-kode
S3_ACCESS_KEY_ID=ganti-dengan-access-key
S3_SECRET_ACCESS_KEY=ganti-dengan-secret-key

# Auth.js (NextAuth) - Strategi JWT
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
AUTH_URL=http://localhost:3000

# Batas Operasional
PORT=3000
MAX_MEDIA_SIZE_BYTES=10485760
MAX_LIVE_STUDENTS=20

# Database pengujian (integration & E2E test)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petualang_kode_test
